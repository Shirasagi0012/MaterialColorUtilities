<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             x:Class="MaterialColorUtilities.Tests.Avalonia.DynamicSeedView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <mcu:MaterialColorResources>
                    <mcu:TonalSpotScheme Color="{DynamicResource SeedColor}" />
                </mcu:MaterialColorResources>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SeedColor">#6750A4</Color>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Name="Target" Background="{DynamicResource {x:Static mcu:SysColorToken.Primary}}" />
</UserControl>
