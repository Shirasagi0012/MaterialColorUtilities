<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             x:Class="MaterialColorUtilities.Tests.Avalonia.ImageSeedNegativeIndexView">
    <UserControl.Resources>
        <mcu:ImageColorSource x:Key="ImageColors" AutoUpdate="False" />
        <mcu:CustomColor x:Key="InvalidColor" Name="Invalid"
            Color="{mcu:ImageSeed {StaticResource ImageColors}, Index=-1}" />
    </UserControl.Resources>
</UserControl>
