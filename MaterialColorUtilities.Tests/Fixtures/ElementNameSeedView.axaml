<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:local="using:MaterialColorUtilities.Tests.Avalonia"
             x:Class="MaterialColorUtilities.Tests.Avalonia.ElementNameSeedView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <mcu:MaterialColorResources>
                    <mcu:TonalSpotScheme Color="{Binding Value, ElementName=SeedTarget}" />
                </mcu:MaterialColorResources>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <local:NativeColorTarget Name="SeedTarget" Value="#6750A4" />
        <Border Name="Target" Background="{DynamicResource {x:Static mcu:SysColorToken.Primary}}" />
    </StackPanel>
</UserControl>
