<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             xmlns:local="using:MaterialColorUtilities.Tests.Avalonia"
             x:Class="MaterialColorUtilities.Tests.Avalonia.MarkupExplicitSourceView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <local:ThemeSettings x:Key="ThemeSettings" SeedColor="#6750A4" />
                </ResourceDictionary>
                <mcu:MaterialColorResources>
                    <mcu:MaterialColorResources.Scheme>
                        <mcu:TonalSpotScheme Color="{ReflectionBinding SeedColor, Source={StaticResource ThemeSettings}}" />
                    </mcu:MaterialColorResources.Scheme>
                </mcu:MaterialColorResources>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Name="Target" Background="{mcu:MdSysColor Primary}" />
</UserControl>
