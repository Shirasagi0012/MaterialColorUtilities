<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia">
    <ResourceDictionary.MergedDictionaries>
        <mcu:MaterialColorResources>
            <mcu:TonalSpotScheme Color="{DynamicResource SeedColor}" />
        </mcu:MaterialColorResources>
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="SeedColor">#6750A4</Color>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ThemedBrush" Color="{DynamicResource {x:Static mcu:SysColorToken.Primary}}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ThemedBrush" Color="{DynamicResource {x:Static mcu:SysColorToken.Primary}}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
