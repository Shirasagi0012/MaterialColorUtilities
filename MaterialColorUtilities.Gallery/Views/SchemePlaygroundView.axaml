<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MaterialColorUtilities.Gallery.Views"
             xmlns:vm="clr-namespace:MaterialColorUtilities.Gallery.ViewModels"
             xmlns:controls="clr-namespace:MaterialColorUtilities.Gallery.Controls"
             xmlns:mcu="https://github.com/Shirasagi0012/MaterialColorUtilities.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1200"
             x:Class="MaterialColorUtilities.Gallery.Views.SchemePlaygroundView"
             x:DataType="vm:SchemePlaygroundViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:SchemePlaygroundViewModel />
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" Spacing="24" Margin="24 40">
        <TextBlock Margin="8 0 0 0" FontSize="40">Color Scheme</TextBlock>
        <DockPanel VerticalAlignment="Top" HorizontalAlignment="Center" VerticalSpacing="16" Width="830">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24" DockPanel.Dock="Bottom">
                <Border Background="{DynamicResource {x:Static mcu:SysColorToken.SurfaceContainerLow}}"
                        Padding="24" CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="20" Margin="0 0 0 8">Customize scheme</TextBlock>
                        
                        <TextBlock FontSize="18" Margin="0 4">Scheme</TextBlock>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SchemeOptions}"
                                  SelectedItem="{Binding SelectedSchemeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SchemeOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <TextBlock FontSize="18" Margin="0 4">Color Spec</TextBlock>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecOptions}"
                                  SelectedItem="{Binding SelectedSpecOption, Mode=TwoWay}">
                            <ComboBox.Styles>
                                <Style Selector="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{ReflectionBinding DataContext.IsEnabled, RelativeSource={RelativeSource Self}}" />
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpecOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>      
                        
                        <TextBlock FontSize="18" Margin="0 4">Platform</TextBlock>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static vm:SchemePlaygroundViewModel.PlatformOptions}"
                                  SelectedItem="{Binding SelectedPlatformOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlatformOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock FontSize="18" Margin="0 4">Contrast</TextBlock>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Slider Grid.Column="0"
                                    Minimum="-1"
                                    Maximum="1"
                                    SmallChange="0.05"
                                    LargeChange="0.25"
                                    Value="{Binding SelectedContrast, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Width="72"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedContrast, StringFormat={}{0:0.00}}" />
                        </Grid>
                        
                        <TextBlock Foreground="{DynamicResource {x:Static mcu:SysColorToken.Error}}" IsVisible="{Binding IsFallback}">
                            fallback to older color spec
                        </TextBlock>

                        <controls:SeedColorPicker
                            Title="Primary Seed Color"
                            Hct="{Binding SelectedHct, Mode=TwoWay}" />

                        <controls:SeedColorPicker
                            Title="Secondary Seed Color"
                            Hct="{Binding SelectedSecondaryHct, Mode=TwoWay}"
                            IsVisible="{Binding IsSecondarySeedVisible}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource {x:Static mcu:SysColorToken.SurfaceContainerLow}}"
                        Padding="24" CornerRadius="12" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock FontSize="20" Text="Custom colors" />
                                <TextBlock Text="{Binding CustomColors.Count}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource {x:Static mcu:SysColorToken.OnSurfaceVariant}}" />
                            </StackPanel>
                            <Button x:Name="AddCustomColorButton" Grid.Column="1" Content="+ Add color" Command="{Binding AddCustomColorCommand}"
                                    Background="{DynamicResource {x:Static mcu:SysColorToken.PrimaryContainer}}"
                                    Foreground="{DynamicResource {x:Static mcu:SysColorToken.OnPrimaryContainer}}" />
                        </Grid>
                        <TextBlock IsVisible="{Binding HasNoCustomColors}" Text="Add a custom color to preview its roles."
                                   TextWrapping="Wrap" Foreground="{DynamicResource {x:Static mcu:SysColorToken.OnSurfaceVariant}}" />
                        <ItemsControl x:Name="CustomColorItems" ItemsSource="{Binding CustomColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="20" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomColorEntryViewModel">
                                    <controls:CustomColorEditor />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <ThemeVariantScope x:Name="SchemePreview" RequestedThemeVariant="{Binding PreviewThemeVariant}">
                <Border VerticalAlignment="Top" Padding="12" CornerRadius="12"
                        Background="{DynamicResource {x:Static mcu:SysColorToken.SurfaceContainerHigh}}">
                    <Border.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <mcu:MaterialColorResources
                                    Scheme="{ReflectionBinding DataContext.Scheme, ElementName=Root}" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </Border.Resources>
                    <views:ColorSchemeView />
                </Border>
            </ThemeVariantScope>
        </DockPanel>
    </StackPanel>
</UserControl>
